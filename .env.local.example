# Local mode: no AWS account needed. cp .env.local.example .env
EXECUTOR=docker          # targets are docker containers (scripts/local_targets.sh)
KB_BACKEND=local         # .nomeshops/fixes.json instead of DynamoDB
STORE_BACKEND=local      # .nomeshops/attempts/ instead of S3
LLM_BACKEND=none         # none | anthropic (needs ANTHROPIC_API_KEY) | bedrock (needs AWS creds)
ANTHROPIC_MODEL=claude-sonnet-4-6
LOCAL_DATA_DIR=.nomeshops
PREEMPT_PREDICTED_FIXES=true
MAX_FIX_ATTEMPTS=3
MAX_LLM_ATTEMPTS=1
