# Copy to .env and fill in. Loaded by app/config.py via python-dotenv.
# Which AWS CLI profile to use locally (leave empty inside ECS, where the task role is used)
AWS_PROFILE=default
AWS_REGION=ap-south-1
# DynamoDB table holding verified fixes (created by scripts/provision.sh)
FIXES_TABLE=deployment_fixes
# S3 bucket for attempt logs + raw SSM output (created by scripts/provision.sh)
LOGS_BUCKET=
# Bedrock model used only on knowledge-base miss. Cross-region inference profile id.
# Check what is available: aws bedrock list-inference-profiles --region $AWS_REGION (global.* profiles work in ap-south-1)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Where target projects get cloned on the EC2 instance
TARGET_WORKDIR=/opt/nomeshops
# SSM command timeout (seconds) for a single deploy/verify script
SSM_TIMEOUT_SECONDS=900
# Stop conditions
MAX_FIX_ATTEMPTS=3
MAX_LLM_ATTEMPTS=1
# Apply deterministic predicted fixes before the first deploy attempt (true/false)
PREEMPT_PREDICTED_FIXES=true
